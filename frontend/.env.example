# API 서버 base URL (axios baseURL). Paths are relative to this.
# 예: http://localhost:8080/api
# 개발에서 Vite 프록시(/api)만 쓰려면 /api 로 둬도 된다.
VITE_API_BASE_URL=/api

# 세션 실시간(STOMP) WebSocket — 채팅 · 참여자 · 퀴즈 알림.
# 비우거나 생략하면 브라우저가 현재 호스트의 /ws 로 접속한다(권장).
#   - 로컬 Vite: /ws → VITE_DEV_API_TARGET 백엔드로 프록시
#   - 배포: nginx·CloudFront /ws → 백엔드 :8080/ws
# 인증이 ACCESS_TOKEN 쿠키 핸드셰이크로만 이뤄지므로, API 와 다른 origin 을 직접 적으면
# 쿠키(SameSite=Lax)가 실리지 않아 CONNECT 가 거부된다 — 되도록 비워 둔다.
# VITE_STOMP_WS_URL=wss://i15a604.p.ssafy.io/ws

# Yjs 동시편집 WebSocket (collab-server).
# 비우거나 생략하면 브라우저가 현재 호스트의 /yjs 로 접속한다.
#   - 로컬 Vite: /yjs → VITE_YJS_PROXY_TARGET(기본 127.0.0.1:1234)
#   - 배포: nginx /yjs → collab-server (ACCESS_TOKEN 쿠키 same-site)
# VITE_YJS_WS_URL=wss://i15a604.p.ssafy.io/yjs
#
# 로컬 collab-server 에 직접 붙일 때만:
# VITE_YJS_WS_URL=ws://127.0.0.1:1234
#
# Vite 프록시 대상 (npm run collab:server → AUTH_DISABLED collab-server)
# VITE_YJS_PROXY_TARGET=http://127.0.0.1:1234
