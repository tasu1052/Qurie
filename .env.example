# docker compose 와 로컬 실행이 함께 읽는 환경변수 목록.
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# ===============================
# Database
# ===============================

# MySQL 컨테이너 초기화용 root 비밀번호. 애플리케이션은 이 계정으로 붙지 않는다.
MYSQL_ROOT_PASSWORD=
# 생성할 스키마 이름. 비우면 qurie 가 된다.
MYSQL_DATABASE=qurie

# DB 컨테이너를 호스트에서 들여다볼 때 쓸 포트. 로컬 MySQL 이 3306 을 점유하므로 기본값을 13306 으로 둔다.
MYSQL_HOST_PORT=13306

# [docker] 애플리케이션 계정. MySQL 컨테이너가 이 계정을 만들고 백엔드 컨테이너가 이걸로 붙는다.
# root 는 넣을 수 없다 — mysql 이미지가 MYSQL_USER=root 를 거부한다.
MYSQL_USER=qurie
MYSQL_PASSWORD=

# [로컬] 컨테이너 없이 IDE/gradle 로 직접 실행할 때만 쓰는 값들.
# docker compose 는 이 세 개를 쓰지 않고 위의 MYSQL_* 과 mysql 서비스명으로 스스로 만든다.
DB_URL=jdbc:mysql://localhost:3306/qurie?characterEncoding=UTF-8&connectionTimeZone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=

# ===============================
# Security / JWT
# ===============================

# HS256 서명 키. 32바이트(256비트) 미만이면 부팅 시 WeakKeyException 으로 뜨지 않는다.
#   openssl rand -base64 48
JWT_SECRET=

# HTTPS 로 서비스할 때 true. HTTP 배포라면 false 로 둬야 쿠키가 살아남는다.
COOKIE_SECURE=true

# ===============================
# 프론트 배포 주소 (S3 / CloudFront)
# ===============================

# 세 값 모두 프론트가 실제로 열리는 origin 이어야 한다. 스킴(https://)까지 정확히, 끝에 슬래시 없이.
# 여러 개면 쉼표로 구분한다.
CORS_ALLOWED_ORIGIN_PATTERNS=https://example.cloudfront.net
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://example.cloudfront.net
# 초대 메일 링크가 이 주소 + /signup?token=... 으로 만들어진다.
FRONTEND_BASE_URL=https://example.cloudfront.net

# ===============================
# Mail (초대 발송) — 선택
# ===============================

# 설정하지 않으면 메일 발송만 건너뛰고, 초대 생성 응답의 signUpUrl 로 수동 전달할 수 있다.
# 쓰려면 docker-compose.yml 의 SPRING_MAIL_* 주석도 함께 풀어야 한다.
#SPRING_MAIL_HOST=smtp.gmail.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
#MAIL_FROM=no-reply@qurie.com
